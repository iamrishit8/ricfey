# Copy to .env and fill in. Never commit .env.
# Each variable is documented in README.md. Empty = not needed yet.

NODE_ENV=development

# API server
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Contains a password: never commit.
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricfey?retryWrites=true&w=majority
MONGODB_URI=

# Optional: a throwaway replica set for DB tests. Tests that need it are skipped when empty.
# NEVER point this at real data: the tests drop the database.
MONGODB_URI_TEST=

# Gemini (C3). Key from https://aistudio.google.com/apikey. Secret: never commit.
GEMINI_API_KEY=
# Model ID from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Daily LLM budget (UTC day). Keep below your free-tier requests/day in AI Studio.
LLM_DAILY_CALL_CAP=16
LLM_DAILY_TOKEN_CAP=1000000

# Web app origin: magic links and post-login redirects point here.
WEB_URL=http://localhost:5173
# Secure cookies work on http://localhost in Chrome/Firefox, not Safari. Must be true in production.
COOKIE_SECURE=true
# true only behind a reverse proxy that sets X-Forwarded-For (rate limits use the client IP).
TRUST_PROXY=false
SESSION_TTL_DAYS=30

# Google OAuth (C4). All three or none. Create at https://console.developers.google.com/auth/clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Resend (C4). Empty in development = magic links are printed to the API console. Required in production.
RESEND_API_KEY=
EMAIL_FROM=
