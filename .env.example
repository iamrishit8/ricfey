# Copy to .env and fill in. Never commit .env.
# Each variable is documented in README.md. Empty = not needed yet.

NODE_ENV=development

# API server
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Contains a password: never commit.
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ricfey?retryWrites=true&w=majority
MONGODB_URI=

# Optional: a throwaway replica set for DB tests. Tests that need it are skipped when empty.
# NEVER point this at real data: the tests drop the database.
MONGODB_URI_TEST=
